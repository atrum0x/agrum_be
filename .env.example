# Copy to .env and fill in. Active values below are for LOCAL development.
# For HOSTING (Render), set the "Hosting:" values as environment variables in the
# Render dashboard instead of committing a .env file.
# Keep comments on their own lines: an inline "# ..." becomes part of the value.

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# DB_NAME / DB_USER are only used by docker-compose to create the Postgres container
DB_NAME=agrum_dev
DB_USER=postgres

DB_URL=jdbc:postgresql://localhost:5432/agrum_dev
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Hosting (Neon): copy host/db/user/password from the Neon connection string
# DB_URL=jdbc:postgresql://ep-xxxx-xxxx.ap-southeast-1.aws.neon.tech/agrum?sslmode=require
# DB_USERNAME=neondb_owner
# DB_PASSWORD=<neon password>

# ---------------------------------------------------------------------------
# Redis / Valkey (optional: the app falls back to Postgres if unreachable)
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Hosting (Render Key Value, same region): use its internal hostname
# REDIS_HOST=red-xxxxxxxxxxxxxxxxxxxx
# REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Superuser (created on startup, bypasses all permission checks)
# ---------------------------------------------------------------------------
SUPERUSER_USERNAME=superuser
SUPERUSER_EMAIL=superuser@system.local
SUPERUSER_PASSWORD=superuser
# Hosting: use a strong, unique password
# SUPERUSER_PASSWORD=<strong password>

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# Must be at least 256 bits (32+ characters). Access token lifetime in ms.
JWT_SECRET=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
JWT_EXP=86400000
# Hosting: generate a random secret, e.g. `openssl rand -base64 48`
# JWT_SECRET=<random 48+ byte string>

# ---------------------------------------------------------------------------
# CORS: comma-separated origins, no spaces, no trailing slash. Wildcards allowed.
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Hosting: your real frontend domain (add https://*.vercel.app only for previews)
# CORS_ALLOWED_ORIGINS=https://agrum.vercel.app

# ---------------------------------------------------------------------------
# Auth cookies
# ---------------------------------------------------------------------------
# Local over http: false / Lax
# Hosting over HTTPS with frontend on another domain: true / None
# COOKIE_DOMAIN: leave empty for host-only cookies (recommended)
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=
# Hosting:
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=None

# ---------------------------------------------------------------------------
# Hosting only (Render sets PORT automatically; leave these unset locally)
# ---------------------------------------------------------------------------
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75 -XX:+UseSerialGC
# SPRING_JPA_SHOW_SQL=false
